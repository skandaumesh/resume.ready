# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# Database — Supabase Postgres (Project Settings → Database → Connection string)
# Use the "Connection pooling" (pgbouncer) URL as DATABASE_URL for the app,
# and the direct connection URL as DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Clerk auth — https://dashboard.clerk.com  (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Gemini (Google AI Studio free tier: 1,500 requests/day, no card) — PRIMARY
# AI provider. Get a key at https://aistudio.google.com → "Get API key".
# At least one of GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY must be set.
GEMINI_API_KEY=""
# Each Gemini model has its OWN free quota, so listing several adds capacity.
GEMINI_MODEL="gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# Groq (fast, generous free tier) — SECOND provider, tried after Gemini and
# before OpenRouter. Stacking multiple free tiers raises the app's total daily
# AI capacity for free. Get a key at https://console.groq.com/keys — check
# that page for current per-model rate limits (they change over time).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b"

# Cerebras (purely free tier, no card, no data-training opt-in) — THIRD
# provider, tried after Gemini/Groq and before OpenRouter. ~1M tokens/day,
# fastest throughput available here. Get a key at https://cloud.cerebras.ai
# (Platform → API Keys) — check there for current limits.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b,qwen-3.8-27b"

# OpenRouter (free-tier AI) — FALLBACK provider when Gemini/Groq/Cerebras are unavailable.
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Free model(s) for generation — COMMA-SEPARATED list tried in order. Free models
# get rate-limited (429) constantly, so listing several lets the app fall through
# to the next when one is busy. The exact free list changes over time; browse
# current options at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL="qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free,apodex/apodex-1.1-mini:free,dots-studio/dots-3-note-preview:free,poolside/laguna-s-2.1:free"

# Public site URL (used for OpenRouter attribution headers). Local dev default:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"